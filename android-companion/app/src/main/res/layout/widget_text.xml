<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="#FAF6F0">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:textColor="#222222" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#444444" android:maxLines="1"/>
    <TextView android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#333333" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp" android:maxLines="8"/>
    <TextView android:id="@+id/w_stamp" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#777777" android:layout_marginTop="4dp"/>
</LinearLayout>
